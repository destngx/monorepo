{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm --ignore-scripts exec vite build",
  "outputDirectory": "build",
  "ignoreCommand": "cd ../.. && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm dlx nx-ignore portfolio-landpage",
  "cleanUrls": true,
  "trailingSlash": false
}
