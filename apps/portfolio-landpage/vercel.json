{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm --ignore-scripts exec vite build",
  "outputDirectory": "build",
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "cleanUrls": true,
  "trailingSlash": false
}
