{
  "name": "portfolio-landpage",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portfolio-landpage/src",
  "tags": ["type:app", "app:portfolio-landpage", "scope:frontend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/build"],
      "options": {
        "command": "pnpm exec vite build",
        "cwd": "apps/portfolio-landpage"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite dev --host --port 8083",
        "cwd": "apps/portfolio-landpage"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm exec vite preview --port 8083",
        "cwd": "apps/portfolio-landpage"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec svelte-kit sync && pnpm exec svelte-check --tsconfig ./tsconfig.json",
        "cwd": "apps/portfolio-landpage"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint .",
        "cwd": "apps/portfolio-landpage"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "apps/portfolio-landpage"
      }
    }
  }
}
