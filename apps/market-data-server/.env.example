# market-data-server Environment Configuration

# VNSTOCK API Key - Required for authenticated access
# Get your API key from https://vnstocks.com/onboard-member/
# Community tier: 60 requests/min (guests get 20/min)
VNSTOCK_API_KEY=your_api_key_here

# Server Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Data Source (VCI or KBS - VCI recommended for stability)
VNSTOCK_SOURCE=VCI

# Cache Configuration
# In-process LRU cache size (always on)
CACHE_MEMORY_MAX_ENTRIES=2048
# Second-tier cache: Upstash Redis when both values below are set, otherwise SQLite
# at CACHE_SQLITE_PATH. Set CACHE_ENABLED=false to use memory only.
CACHE_ENABLED=true
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
# Defaults to wealth-management's cache file (<system temp>/wealth-management/cache.db),
# so both apps share one file; keys are kept apart by CACHE_KEY_PREFIX.
# CACHE_SQLITE_PATH=
# Prefix of this server's L2 keys (SQLite and Upstash). Clearing the cache deletes
# only keys under it. Must differ from wealth-management's (default wm:).
# CACHE_KEY_PREFIX=mds:

# Market API (v2)
# Last-good copies served when every source fails (default data/market.sqlite3)
# MARKET_DB_PATH=data/market.sqlite3
# Override provider chains (JSON), e.g. {"candles": ["yahoo", "vnstock"]}
# MARKET_CHAINS=
# Optional CoinGecko demo key for a higher rate limit
# COINGECKO_API_KEY=
# Source base URLs (defaults shown)
# FMARKET_BASE_URL=https://api.fmarket.vn
# YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# CURRENCY_API_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest
# Algolab MCP (last fallback for VN tickers, series and candles). Without a key
# the keyless /free pool is used (shared 120/min, 1,000/day). A free Lite
# account key (alm_...) gives the account its own quota.
# ALGOLAB_API_KEY=
# ALGOLAB_BASE_URL=https://mcp.algolab.vn
