{
  "name": "market-data-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/market-data-server/src",
  "projectType": "application",
  "tags": ["type:app", "app:market-data-server", "scope:backend", "lang:python"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked uvicorn src.main:app --reload --reload-dir src --port 8000",
        "cwd": "apps/market-data-server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. uv run --locked pytest",
        "cwd": "apps/market-data-server"
      },
      "inputs": ["default", "{projectRoot}/tests/**/*"]
    }
  }
}
