{
  "name": "herdr-watcher",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["ui-kit"],
  "sourceRoot": "apps/herdr-watcher",
  "tags": [
    "type:app",
    "app:herdr-watcher",
    "scope:tooling",
    "scope:backend",
    "scope:frontend",
    "lang:go",
    "lang:typescript"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o dist/herdr-watcher .",
        "cwd": "apps/herdr-watcher"
      },
      "cache": true,
      "inputs": ["default", "^default", "!{projectRoot}/ui/**/*"],
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/herdr-watcher serve",
        "cwd": "apps/herdr-watcher"
      },
      "cache": false
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-ui"],
      "options": {
        "command": "go run .",
        "cwd": "apps/herdr-watcher"
      },
      "cache": false
    },
    "serve-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite dev --host",
        "cwd": "apps/herdr-watcher/ui"
      }
    },
    "build-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite build",
        "cwd": "apps/herdr-watcher/ui"
      },
      "cache": true,
      "inputs": ["{projectRoot}/ui/**/*", "!{projectRoot}/ui/build/**/*", "{workspaceRoot}/libs/ui-kit/src/**/*"],
      "outputs": ["{projectRoot}/ui/build"]
    },
    "check-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec svelte-kit sync && pnpm exec svelte-check --tsconfig ./tsconfig.json",
        "cwd": "apps/herdr-watcher/ui"
      }
    },
    "lint-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec svelte-kit sync && pnpm exec eslint --concurrency auto .",
        "cwd": "apps/herdr-watcher/ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -race ./...",
        "cwd": "apps/herdr-watcher"
      },
      "inputs": ["default", "!{projectRoot}/ui/**/*"]
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "apps/herdr-watcher/ui"
      }
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "find . -name '*.go' -not -path './ui/*' -exec gofmt -w {} +",
        "cwd": "apps/herdr-watcher"
      }
    },
    "load-agent": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/herdr-watcher install",
        "cwd": "apps/herdr-watcher"
      },
      "cache": false
    },
    "unload-agent": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/herdr-watcher uninstall",
        "cwd": "apps/herdr-watcher"
      },
      "cache": false
    },
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/herdr-watcher status",
        "cwd": "apps/herdr-watcher"
      },
      "cache": false
    }
  }
}
