{
  "name": "wealth-management",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/wealth-management",
  "tags": ["type:app", "app:wealth-management", "scope:backend", "scope:frontend", "lang:go", "lang:typescript"],
  "targets": {
    "build": {
      "executor": "@nx-go/nx-go:build",
      "options": {
        "main": "main.go"
      },
      "cache": true,
      "inputs": ["default", "^default", "!{projectRoot}/ui/**/*"],
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["pnpx nx run wealth-management:serve-api", "pnpx nx run wealth-management:serve-ui"],
        "parallel": true
      }
    },
    "serve-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run github.com/air-verse/air@latest -c .air.toml",
        "cwd": "apps/wealth-management"
      },
      "cache": false
    },
    "serve-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpx vite dev --host",
        "cwd": "apps/wealth-management/ui"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build-ui",
          "configurations": "production"
        }
      ],
      "options": {
        "command": "go run .",
        "cwd": "apps/wealth-management"
      },
      "cache": false
    },
    "build-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpx vite build",
        "cwd": "apps/wealth-management/ui"
      },
      "configurations": {
        "production": {
          "command": "pnpx vite build --mode production",
          "cwd": "apps/wealth-management/ui"
        }
      }
    },
    "check-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec svelte-kit sync && pnpm exec svelte-check --tsconfig ./tsconfig.json",
        "cwd": "apps/wealth-management/ui"
      }
    },
    "lint-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpx eslint .",
        "cwd": "apps/wealth-management/ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/wealth-management"
      },
      "inputs": ["default", "!{projectRoot}/ui/**/*"]
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpx vitest run --passWithNoTests",
        "cwd": "apps/wealth-management/ui"
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "RUN_LIVE_API_TESTS=true go test ./e2e/ -run '^TestE2E' -count=1 -v -timeout 20m",
        "cwd": "apps/wealth-management"
      }
    },
    "auth-sheets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/google_oauth_setup",
        "cwd": "apps/wealth-management"
      },
      "cache": false
    },
    "verify-auth": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/verify_auth",
        "cwd": "apps/wealth-management"
      },
      "cache": false
    },
    "lint": {
      "executor": "@nx-go/nx-go:lint"
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "find . -name '*.go' -not -path './tmp/*' -not -path './ui/*' -exec gofmt -w {} +",
        "cwd": "apps/wealth-management"
      }
    },
    "tidy": {
      "executor": "@nx-go/nx-go:tidy"
    }
  }
}
