{
  "name": "graph-weave",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/graph-weave/src",
  "projectType": "application",
  "tags": ["type:app", "app:graph-weave", "scope:backend", "scope:frontend", "lang:python", "lang:typescript"],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv pip install -r requirements.txt",
        "cwd": "apps/graph-weave"
      },
      "inputs": ["{projectRoot}/requirements.txt"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["pnpm exec nx run graph-weave:serve-api", "pnpm exec nx run graph-weave:serve-ui"],
        "parallel": true
      }
    },
    "serve-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/uvicorn src.main:app --reload --reload-dir src --host 0.0.0.0 --port 8001",
        "cwd": "apps/graph-weave"
      }
    },
    "serve-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite dev --host --port 8082",
        "cwd": "apps/graph-weave/ui"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build-ui",
          "configurations": "production"
        }
      ],
      "options": {
        "command": ".venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8001",
        "cwd": "apps/graph-weave"
      }
    },
    "build-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vite build",
        "cwd": "apps/graph-weave/ui"
      },
      "configurations": {
        "production": {
          "command": "pnpm exec vite build --mode production",
          "cwd": "apps/graph-weave/ui"
        }
      }
    },
    "check-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec svelte-kit sync && pnpm exec svelte-check --tsconfig ./tsconfig.json",
        "cwd": "apps/graph-weave/ui"
      }
    },
    "lint-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec svelte-kit sync && pnpm exec eslint .",
        "cwd": "apps/graph-weave/ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. .venv/bin/pytest tests/unit",
        "cwd": "apps/graph-weave"
      },
      "inputs": ["default", "!{projectRoot}/ui/**/*", "{projectRoot}/tests/unit/**/*"]
    },
    "test-ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest",
        "cwd": "apps/graph-weave/ui"
      }
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. .venv/bin/pytest tests/e2e",
        "cwd": "apps/graph-weave"
      },
      "inputs": ["default", "!{projectRoot}/ui/**/*", "{projectRoot}/tests/e2e/**/*"]
    },
    "setup-github-token": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python scripts/setup_github_token.py",
        "cwd": "apps/graph-weave"
      }
    }
  }
}
