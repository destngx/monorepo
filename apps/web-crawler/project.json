{
  "name": "web-crawler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-crawler/src",
  "projectType": "application",
  "tags": ["type:app", "app:web-crawler", "scope:backend", "lang:python"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. uv run --locked python -m compileall src tests",
        "cwd": "apps/web-crawler",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "apps/web-crawler/.venv"
        }
      },
      "inputs": ["default", "^default"],
      "outputs": []
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked uvicorn src.main:app --reload --reload-dir src --host 0.0.0.0 --port 8002",
        "cwd": "apps/web-crawler",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "apps/web-crawler/.venv"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. uv run --locked pytest tests/unit",
        "cwd": "apps/web-crawler",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "apps/web-crawler/.venv"
        }
      },
      "inputs": ["default", "{projectRoot}/tests/unit/**/*"]
    },
    "test-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. uv run --locked pytest tests/e2e",
        "cwd": "apps/web-crawler",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "apps/web-crawler/.venv"
        }
      },
      "inputs": ["default", "{projectRoot}/tests/e2e/**/*"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. uv run --locked ruff check src tests",
        "cwd": "apps/web-crawler",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "apps/web-crawler/.venv"
        }
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=. uv run --locked black --check src tests",
        "cwd": "apps/web-crawler",
        "env": {
          "UV_PROJECT_ENVIRONMENT": "apps/web-crawler/.venv"
        }
      }
    }
  }
}
