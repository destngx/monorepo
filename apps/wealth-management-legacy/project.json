{
  "name": "wealth-management",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/wealth-management/src",
  "projectType": "application",
  "tags": ["type:app", "app:wealth-management", "scope:frontend"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/wealth-management/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "setup-ai": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun apps/wealth-management/scripts/setup-ai.ts"
      }
    },
    "setup-oauth": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun apps/wealth-management/scripts/setup-oauth.ts"
      }
    },
    "verify-auth": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun apps/wealth-management/scripts/verify-auth.ts"
      }
    }
  }
}
