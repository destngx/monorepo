{
  "name": "wealth-management-engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/wealth-management-engine",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run github.com/air-verse/air@latest -c .air.toml",
        "cwd": "apps/wealth-management-engine"
      },
      "cache": false
    },
    "auth-sheets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/google_oauth_setup",
        "cwd": "apps/wealth-management-engine"
      },
      "cache": false
    }
  }
}
