#!/bin/zsh
# herdr-mobile: runs the phone page in the foreground (serve), or builds it in
# the primary checkout and keeps it running with launchd (install). Both publish
# it on the tailnet with `tailscale serve`.
# See docs/herdr-mobile/README.md.
setopt err_exit no_unset pipe_fail

: ${HM_PORT:=9393}  # the local port, and the tailnet HTTPS port

APP_DIR=${0:A:h:h}
LABEL=com.destngx.monorepo.herdr-mobile
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist

usage() {
  print -r -- "Usage: herdr-mobile [serve|install|uninstall|status]

  serve      build this checkout and run it in the foreground, on the tailnet until Ctrl+C
  install    build the engine and UI in the primary checkout, load the launchd agent,
             and serve it on the tailnet at https://<this mac>.ts.net:$HM_PORT/
  uninstall  stop serving on the tailnet, unload the agent and remove its plist
  status     show the agent, the tailnet address and the last log lines"
}

die() {
  print -u2 -r -- "herdr-mobile: $1"
  exit 1
}

primary_root() {
  local common
  common=$(git -C $APP_DIR rev-parse --path-format=absolute --git-common-dir) ||
    die "cannot find the repo from $APP_DIR"
  print -r -- ${common:h}
}

logs_dir() { print -r -- $(primary_root)/tmp/herdr-mobile }

tailnet_url() {
  local name
  name=$(tailscale status --json | /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))') ||
    return 1
  print -r -- "https://$name:$HM_PORT/"
}

plist_content() {
  local app=$1 logs=$2
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$app/dist/herdr-mobile</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$app</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HM_ADDR</key>
    <string>127.0.0.1:$HM_PORT</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>$logs/launchd.log</string>
</dict>
</plist>
PLIST
}

cmd_install() {
  local primary app logs url
  primary=$(primary_root)
  app=$primary/apps/herdr-mobile
  [[ -f $app/main.go ]] ||
    die "$app not found. Merge herdr-mobile to main and pull the primary checkout first."
  print -r -- "herdr-mobile: building in $app"
  (cd $primary && pnpm exec nx run herdr-mobile:build-ui --skip-nx-cache) || die "UI build failed"
  (cd $app && go build -o dist/herdr-mobile .) || die "engine build failed"

  logs=$(logs_dir)
  mkdir -p $logs ${PLIST:h}
  plist_content $app $logs > $PLIST
  plutil -lint $PLIST > /dev/null || die "generated an invalid plist at $PLIST"
  launchctl bootout gui/$UID/$LABEL 2> /dev/null || true
  launchctl bootstrap gui/$UID $PLIST
  print -r -- "herdr-mobile: loaded $LABEL on 127.0.0.1:$HM_PORT"

  # Tailnet only (serve, not funnel): reachable from your own devices, never the internet.
  tailscale serve --bg --https=$HM_PORT http://127.0.0.1:$HM_PORT > /dev/null ||
    die "tailscale serve failed; the engine still runs on 127.0.0.1:$HM_PORT"
  url=$(tailnet_url) || die "could not read this Mac's tailnet name"
  print -r -- "herdr-mobile: open $url on the phone"
}

# Runs this checkout's build in the foreground. The tailnet address is
# published only while it runs: `tailscale serve` without --bg removes it on exit.
cmd_serve() {
  local engine_pid tailscale_pid url
  if curl -fsS -o /dev/null http://127.0.0.1:$HM_PORT/healthz 2> /dev/null; then
    die "something already answers on 127.0.0.1:$HM_PORT (the launchd agent?). Run unload-agent, or set HM_PORT."
  fi
  print -r -- "herdr-mobile: building in $APP_DIR"
  (cd $APP_DIR/ui && pnpm exec vite build > /dev/null) || die "UI build failed"
  (cd $APP_DIR && go build -o dist/herdr-mobile .) || die "engine build failed"

  (cd $APP_DIR && HM_ADDR=127.0.0.1:$HM_PORT exec ./dist/herdr-mobile) &
  engine_pid=$!
  tailscale serve --https=$HM_PORT http://127.0.0.1:$HM_PORT > /dev/null &
  tailscale_pid=$!
  trap 'kill $tailscale_pid $engine_pid 2> /dev/null; wait; print -r -- "herdr-mobile: stopped"' EXIT
  trap 'exit 0' INT TERM

  url=$(tailnet_url) || die "could not read this Mac's tailnet name"
  print -r -- "herdr-mobile: open $url on the phone (Ctrl+C to stop)"
  wait $engine_pid
}

cmd_uninstall() {
  tailscale serve --https=$HM_PORT off > /dev/null 2>&1 || true
  launchctl bootout gui/$UID/$LABEL 2> /dev/null || true
  rm -f $PLIST
  print -r -- "herdr-mobile: stopped serving on the tailnet, unloaded $LABEL and removed $PLIST"
}

cmd_status() {
  if launchctl print gui/$UID/$LABEL > /dev/null 2>&1; then
    print -r -- "launchd agent: loaded ($PLIST)"
  else
    print -r -- "launchd agent: not loaded (run: nx run herdr-mobile:load-agent)"
  fi
  if curl -fsS -o /dev/null http://127.0.0.1:$HM_PORT/healthz 2> /dev/null; then
    print -r -- "engine: answering on 127.0.0.1:$HM_PORT"
  else
    print -r -- "engine: not answering on 127.0.0.1:$HM_PORT"
  fi
  print -r -- "tailnet: $(tailnet_url || print -r -- unknown)"
  local log=$(logs_dir)/launchd.log
  if [[ -s $log ]]; then
    print -r -- "last log lines ($log):"
    tail -5 $log | sed 's/^/  /'
  fi
}

case ${1:-status} in
  serve) cmd_serve ;;
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  status) cmd_status ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
